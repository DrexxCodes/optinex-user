# ── Backend (optinex-backend, Fastify) ──
# The ONLY server-side setting this app needs. Every /api/* call is rewritten to it (see next.config.js).
# Supabase, Redis, Firebase-admin, Paystack, UploadThing and cron secrets now live in the backend's .env.
BACKEND_URL=http://localhost:4000

# ── Firebase: Cloud Messaging (browser push registration) ONLY ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Safe to delete from your .env now (moved to the backend): NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, SUPABASE_SERVICE_ROLE_KEY, UPSTASH_REDIS_REST_URL,
# UPSTASH_REDIS_REST_TOKEN, FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY,
# PAYSTACK_SECRET_KEY, CRON_SECRET, UPLOADTHING_TOKEN, NEXT_PUBLIC_BACKEND_URL.
